{
  "name": "compras-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do Sistema de Gestao de Compras, Estoque e Fornecedores",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "tsx src/scripts/reset.ts",
    "db:transferir": "tsx src/scripts/transferir-dados.ts",
    "test:smoke": "tsx src/scripts/smoke-test.ts",
    "test:m04": "tsx src/scripts/testes/m04-demanda.ts",
    "test:m05": "tsx src/scripts/testes/m05-planejamento.ts",
    "test:m06": "tsx src/scripts/testes/m06-cotacoes.ts",
    "test:m07": "tsx src/scripts/testes/m07-negociacao.ts",
    "test:m08": "tsx src/scripts/testes/m08-entregas.ts",
    "test:m09": "tsx src/scripts/testes/m09-recebimento.ts",
    "test:m10": "tsx src/scripts/testes/m10-avaliacao.ts",
    "test:m11": "tsx src/scripts/testes/m11-bi.ts",
    "test:m12": "tsx src/scripts/testes/m12-ia.ts",
    "test:m13": "tsx src/scripts/testes/m13-automacao.ts",
    "test:m14": "tsx src/scripts/testes/m14-integracao.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
