# ------------------------------------------------------------------
# Aplicacao
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------
# Banco de dados PostgreSQL
# ------------------------------------------------------------------
# Supabase (recomendado): Dashboard > Connect > "Session pooler" (porta 5432).
#   - Funciona em IPv4 (sua maquina e a Vercel). A conexao direta
#     db.<ref>.supabase.co e so IPv6 no plano gratuito.
#   - NAO use o "Transaction pooler" (porta 6543): a API ajusta o fuso da
#     sessao e isso exige modo sessao.
#   - A senha e a do banco (Project Settings > Database), nao a do login.
# DATABASE_URL=postgresql://postgres.<ref-do-projeto>:<senha-do-banco>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
# PGSSL=true
#
# PostgreSQL local (alternativa para desenvolver sem internet):
DATABASE_URL=postgresql://compras_app:troque_esta_senha@localhost:5432/compras
# Opcional: conexao somente leitura para as consultas analiticas da IA (modulo 12).
# Provisione o papel com: psql -U postgres -d compras -f db/roles/001_papel_leitura_ia.sql
# DATABASE_URL_LEITURA=postgres://compras_ia:TROQUE_ESTA_SENHA@localhost:5432/compras
PGSSL=false
# Na Vercel use 2 ou 3: cada instancia da funcao abre o proprio pool.
PG_POOL_MAX=10

# ------------------------------------------------------------------
# Autenticacao
# ------------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-em-producao-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Limite de tentativas de login por janela. O padrao (10 / 15 min) vale para
# producao; ambientes de teste precisam de um teto maior para rodar as baterias.
LOGIN_TENTATIVAS_MAX=10
LOGIN_JANELA_MINUTOS=15

# ------------------------------------------------------------------
# Seed (usuario administrador inicial)
# ------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@empresa.com.br
SEED_ADMIN_SENHA=Admin@123
SEED_DADOS_TESTE=true

# ------------------------------------------------------------------
# Transferencia de dados (npm run db:transferir) - so quando for usar
# ------------------------------------------------------------------
# Banco de ONDE os dados saem (ex.: o PostgreSQL local usado ate agora).
# O destino e a DATABASE_URL acima.
# ORIGEM_DATABASE_URL=postgresql://compras_app:troque_esta_senha@localhost:5432/compras
